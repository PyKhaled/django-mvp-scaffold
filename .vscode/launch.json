{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run development server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DJANGO_ENV": "development",
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Django: Run tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "--noinput"],
      "django": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DJANGO_ENV": "development",
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
